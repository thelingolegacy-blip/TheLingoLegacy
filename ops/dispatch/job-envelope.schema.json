{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/llg-dispatch-job-v1.json",
  "title": "LLG Dispatch Job Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "parent_id", "workstream", "owner_role", "reviewer_role", "repository", "branch", "commit_sha", "environment", "risk_class", "scope", "input_refs", "dependency_ids", "allowed_tools", "permission_profile", "idempotency_key", "acceptance_tests", "timeout_seconds", "lease_seconds", "heartbeat_seconds", "retry_budget", "cost_ceiling_usd", "start_condition", "stop_condition", "output_refs", "evidence_refs", "status"],
  "properties": {
    "job_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"},
    "parent_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"},
    "workstream": {"type":"string","minLength":1},
    "owner_role": {"type":"string","minLength":1},
    "reviewer_role": {"type":"string","minLength":1},
    "repository": {"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "branch": {"type":"string","minLength":1},
    "commit_sha": {"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "environment": {"enum":["local","test","preview","staging"]},
    "risk_class": {"enum":["low","medium","high","critical"]},
    "scope": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "input_refs": {"type":"array","items":{"type":"string","minLength":1}},
    "dependency_ids": {"type":"array","items":{"type":"string","minLength":1}},
    "allowed_tools": {"type":"array","items":{"type":"string","minLength":1}},
    "permission_profile": {"type":"string","minLength":1},
    "idempotency_key": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"},
    "acceptance_tests": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "timeout_seconds": {"type":"integer","minimum":1},
    "lease_seconds": {"type":"integer","minimum":1},
    "heartbeat_seconds": {"type":"integer","minimum":1},
    "retry_budget": {"type":"integer","minimum":0,"maximum":5},
    "cost_ceiling_usd": {"type":"number","minimum":0},
    "start_condition": {"type":"string","minLength":1},
    "stop_condition": {"type":"string","minLength":1},
    "output_refs": {"type":"array","items":{"type":"string","minLength":1}},
    "evidence_refs": {"type":"array","items":{"type":"string","minLength":1}},
    "status": {"enum":["PROPOSED","READY","DISPATCHED","ACCEPTED","RUNNING","VERIFYING","COMPLETE","BLOCKED","REJECTED","FAILED","CANCELLED","EXPIRED","QUARANTINED"]}
  }
}
