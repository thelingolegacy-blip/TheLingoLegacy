# Lingo Legacy OS deployment variable map
# Copy only the keys you actually use into Vercel Project Settings > Environment Variables.
# Do not commit real secret values.

# Identity & session
AUTH_PUBLIC_KEY=
AUTH_PRIVATE_KEY=
SESSION_SECRET=

# Data layer
# Neon is the current Marketplace relational path; Vercel Postgres is no longer first-party.
POSTGRES_URL=
NEON_DATABASE_URL=
# Upstash Redis is the current Marketplace key-value/cache path; Vercel KV is no longer first-party.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Object storage
# Vercel Blob is first-party file storage.
BLOB_READ_WRITE_TOKEN=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GLOBAL_ASSET_BUCKET=

# Internal OS services
OS_INTERNAL_API_KEY=
ACTIVEPIECES_WEBHOOK_URL=

# Wallet system
WALLET_SECRET=

# XP engine
XP_ENGINE_SECRET=

# Admin Command Center
ADMIN_COMMAND_CENTER_KEY=

# Lingo.ai integration
LINGO_AI_ENDPOINT=
LINGO_AI_KEY=

# Beacon text alerts
# Use either a workflow webhook or Twilio to send live SMS confirmations.
BEACON_ALERTS_WEBHOOK_URL=
BEACON_ALERTS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe checkout
# Create Stripe Price IDs for each founder-drop tier and store live/test keys in Vercel only.
STRIPE_SECRET_KEY=
STRIPE_PRICE_XP_PACK=
STRIPE_PRICE_MYSTERY_KEY_PACK=
STRIPE_PRICE_AVALON_BADGE_SET=
PUBLIC_SITE_URL=


# Flutter / Firebase contract placeholders
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=

# Cloudflare contract placeholders
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# GitHub automation contract placeholders
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
