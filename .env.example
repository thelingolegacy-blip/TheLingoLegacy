# Lingo Legacy OS deployment variable map
# Copy only the keys you actually use into Vercel Project Settings > Environment Variables.
# Do not commit real secret values.

# Identity & session
AUTH_PUBLIC_KEY=
AUTH_PRIVATE_KEY=
SESSION_SECRET=

# Data layer
POSTGRES_URL=
REDIS_URL=

# Object storage
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
GLOBAL_ASSET_BUCKET=

# Internal OS services
OS_INTERNAL_API_KEY=
ACTIVEPIECES_WEBHOOK_URL=

# Wallet system
WALLET_SECRET=

# XP engine
XP_ENGINE_SECRET=

# Admin Command Center
ADMIN_COMMAND_CENTER_KEY=

# Lingo.ai integration
LINGO_AI_ENDPOINT=
LINGO_AI_KEY=

# Beacon text alerts
# Use either a workflow webhook or Twilio to send live SMS confirmations.
BEACON_ALERTS_WEBHOOK_URL=
BEACON_ALERTS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
