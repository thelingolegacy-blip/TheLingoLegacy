      "id": "M01-GITHUB-CONTROL",
      "name": "GitHub Actions control plane",
      "kind": "managed-control-plane",
      "purpose": "Accept workflow dispatches, assign jobs, expose steps/logs/artifacts",
      "currentStatus": "PARTIAL_FAILURE",
      "knownEvidence": ["PR #249 workflow jobs previously completed with failure and empty step arrays", "log retrieval returned BlobNotFound", "retry request accepted but latest observed job was queued"],
      "requiredTelemetry": ["workflow_run_id", "workflow_job_id", "head_sha", "status", "conclusion", "runner_id", "runner_name", "started_at", "completed_at", "steps", "log_uri", "artifact_ids"],
      "ownerRole": "CI_PLATFORM_OPERATOR",
      "mutationAllowed": "DIAGNOSTIC_ONLY"
    },
    {
      "id": "M02-GITHUB-HOSTED-RUNNER",
      "name": "GitHub-hosted ubuntu-latest runner",
