{
  "schemaVersion": "1.0.0",
  "system": "LINGOsonic Nexus machine and diagnostic inventory",
  "updatedAtUtc": "2026-10-10",
  "policy": {
    "productionMutation": "FROZEN",
    "mainMerge": "PROHIBITED_UNTIL_ACCEPTED",
    "unknownStatus": "UNVERIFIED_NOT_ONLINE",
