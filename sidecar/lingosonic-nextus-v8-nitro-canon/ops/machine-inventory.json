      "currentStatus": "UNVERIFIED_NO_EXECUTION_EVIDENCE",
      "requiredTelemetry": ["runner_id_gt_zero", "runner_name", "first_step_started", "checkout_sha", "step_conclusions", "log_retrieval", "artifact_digest"],
      "ownerRole": "CI_PLATFORM_OPERATOR",
      "mutationAllowed": "ISOLATED_CI_ONLY"
    },
    {
      "id": "M03-SELF-HOSTED-G02",
