{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thelingolegacy",
  "main": "worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "thelingolegacy.com/*",
      "zone_name": "thelingolegacy.com"
    },
    {
      "pattern": "www.thelingolegacy.com/*",
      "zone_name": "thelingolegacy.com"
    }
  ],
  "vars": {
    "CANONICAL_DOMAIN": "thelingolegacy.com",
    "PUBLIC_SITE_URL": "https://thelingolegacy.com"
  },
  "previews": {
    "vars": {
      "CANONICAL_DOMAIN": "preview.thelingolegacy.com",
      "PUBLIC_SITE_URL": "https://preview.thelingolegacy.com"
    }
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
