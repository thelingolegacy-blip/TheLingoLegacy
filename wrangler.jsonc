{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thelingolegacyv-5",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "thelingolegacy.com/*",
      "zone_name": "thelingolegacy.com"
    },
    {
      "pattern": "www.thelingolegacy.com/*",
      "zone_name": "thelingolegacy.com"
    }
  ],
  "vars": {
    "CANONICAL_DOMAIN": "thelingolegacy.com",
    "PUBLIC_SITE_URL": "https://thelingolegacy.com"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BEACON_RATE_LIMITER",
        "class_name": "BeaconRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BeaconRateLimiter"
      ]
    }
  ]
}
