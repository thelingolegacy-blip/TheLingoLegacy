#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$ROOT"
need_env() {
  [ -f .env ] || { echo "Create vsm/.env from .env.example and set VSM_OWNER_TOKEN."; exit 2; }
}
case "${1:-help}" in
  up) need_env; docker compose up --build -d ;;
  down) docker compose down ;;
  status) docker compose ps; curl -fsS http://127.0.0.1:8787/api/health || true ;;
  logs) docker compose logs -f --tail=150 ;;
  probe) [ -n "${2:-}" ] || { echo "Usage: sh vsm/lingo-vsm probe RELEASE_ID"; exit 2; }; curl -fsS -X POST "http://127.0.0.1:8787/api/releases/$2/probe" ;;
  dispatch) [ "$#" -ge 4 ] || { echo "Usage: sh vsm/lingo-vsm dispatch 'Title' COMMIT_SHA [BRANCH] [TARGET]"; exit 2; }; TITLE=$2; SHA=$3; BRANCH=${4:-main}; TARGET=${5:-local-preview}; node -e 'process.stdout.write(JSON.stringify({title:process.argv[1],source:{repo:"thelingolegacy-blip/TheLingoLegacy",branch:process.argv[3],commit:process.argv[2]},target:process.argv[4]}))' "$TITLE" "$SHA" "$BRANCH" "$TARGET" | curl -fsS -H 'Content-Type: application/json' -d @- http://127.0.0.1:8787/api/releases ;;
  attest) need_env; [ "$#" -ge 6 ] || { echo "Usage: sh vsm/lingo-vsm attest RELEASE_ID GATE PASS|FAIL|HOLD EVIDENCE_REF 'RATIONALE'"; exit 2; }; . ./.env; ID=$2; GATE=$3; DECISION=$4; EVIDENCE=$5; RATIONALE=$6; node -e 'process.stdout.write(JSON.stringify({decision:process.argv[1],evidence_ref:process.argv[2],rationale:process.argv[3]}))' "$DECISION" "$EVIDENCE" "$RATIONALE" | curl -fsS -X POST -H "Authorization: Bearer $VSM_OWNER_TOKEN" -H 'Content-Type: application/json' -d @- "http://127.0.0.1:8787/api/releases/$ID/gates/$GATE" ;;
  accept) need_env; [ -n "${2:-}" ] || { echo "Usage: sh vsm/lingo-vsm accept RELEASE_ID"; exit 2; }; . ./.env; curl -fsS -X POST -H "Authorization: Bearer $VSM_OWNER_TOKEN" "http://127.0.0.1:8787/api/releases/$2/accept" ;;
  help|*) echo "Usage: sh vsm/lingo-vsm {up|down|status|logs|dispatch|probe|attest|accept}" ;;
esac
