{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LINGO ID Principal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "handle",
    "display_name",
    "status",
    "roles",
    "public_key",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^lingo://id/[a-z0-9][a-z0-9._-]{1,31}$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,31}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "revoked"
      ]
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "owner",
          "engineer",
          "studio_lead",
          "release_manager",
          "security_auditor",
          "operator",
          "bot"
        ]
      }
    },
    "public_key": {
      "type": "string",
      "minLength": 40
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
