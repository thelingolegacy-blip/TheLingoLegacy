{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/creative-asset-manifest.schema.json",
  "title": "LINGOlegacy Creative Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["working-draft", "review", "approved"] },
    "policy": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "product", "mediaType", "source", "creator", "createdAt", "licenseStatus", "usageScope", "publicationStatus"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,79}$" },
          "title": { "type": "string", "minLength": 1 },
          "product": { "enum": ["LINGOlegacy", "LINGOlane", "LINGOslots", "LINGOarcade", "LINGOlibrary", "LINGOmedia", "LINGOworld", "LegacyXclub"] },
          "mediaType": { "enum": ["image", "vector", "video", "audio", "document", "font", "ui-component", "3d", "other"] },
          "format": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string" },
          "creator": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "createdAt": { "type": "string", "minLength": 1 },
          "licenseStatus": { "enum": ["UNKNOWN", "EVIDENCE_REQUESTED", "IN_REVIEW", "CLEARED_WITH_LIMITS", "NOT_CLEARED", "EXPIRED", "CLEARED"] },
          "licenseEvidenceUrl": { "type": "string" },
          "usageScope": { "type": "string", "minLength": 1 },
          "dimensions": { "type": "object", "additionalProperties": false, "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "durationSeconds": { "type": "number", "minimum": 0 } } },
          "checksumSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "canvaDesignUrl": { "type": "string" },
          "approvalOwner": { "type": "string" },
          "publicationStatus": { "enum": ["DRAFT", "IN_REVIEW", "APPROVED_FOR_PUBLICATION", "PROTECTED_HOLD", "ARCHIVED"] },
          "claims": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
