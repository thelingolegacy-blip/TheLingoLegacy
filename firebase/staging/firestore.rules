rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validMarkerFields() {
      return request.resource.data.keys().hasAll([
          'name',
          'latitude',
          'longitude',
          'category',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'latitude',
          'longitude',
          'category',
          'visibility',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 40
        && request.resource.data.visibility == 'private';
    }

    match /users/{uid}/saved_locations/{markerId} {
      allow get, list: if ownsUser(uid);

      allow create: if ownsUser(uid)
        && validMarkerFields()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if ownsUser(uid)
        && validMarkerFields()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if ownsUser(uid);
    }

    // All other collections remain denied until their own schema and rules
    // have been reviewed and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
