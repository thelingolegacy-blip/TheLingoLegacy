{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/lingo-ecosystem-registry.v1.schema.json",
  "title": "LINGO Ecosystem Registry",
  "type": "object",
  "required": [
    "schema_version",
    "authority",
    "source_of_truth",
    "production_policy",
    "environments",
    "realms",
    "status_definitions",
    "release_gates",
    "explicit_disabled"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "authority": {
      "type": "string",
      "const": "LINGOlegacy_MASTER"
    },
    "source_of_truth": {
      "type": "string",
      "format": "uri"
    },
    "production_policy": {
      "type": "string",
      "enum": [
        "protected-hold",
        "controlled-release"
      ]
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "local",
          "preview",
          "integration",
          "staging",
          "production"
        ]
      },
      "uniqueItems": true
    },
    "platforms": {
      "type": "object"
    },
    "realms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "status",
          "products",
          "dependencies",
          "node_type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "planned-disabled",
              "scaffolded-unverified",
              "preview-needs-independent-qa",
              "verified",
              "production",
              "live-uncertified"
            ]
          },
          "route": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^/"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "release_record": {
            "type": "string"
          },
          "last_verified_commit": {
            "type": "string"
          },
          "last_verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "owner_acceptance": {
            "type": "string"
          },
          "node_type": {
            "type": "string",
            "enum": [
              "public_portfolio",
              "subproduct",
              "shared_platform_service"
            ]
          },
          "parent_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "properties": {
                "node_type": {
                  "const": "subproduct"
                }
              },
              "required": [
                "node_type"
              ]
            },
            "then": {
              "required": [
                "parent_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "node_type": {
                  "enum": [
                    "public_portfolio",
                    "shared_platform_service"
                  ]
                }
              },
              "required": [
                "node_type"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "parent_id"
                ]
              }
            }
          }
        ]
      }
    },
    "status_definitions": {
      "type": "object"
    },
    "release_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "explicit_disabled": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
