{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/release-governance/surface-matrix.registry.schema.json",
  "title": "LINGO Legacy Surface Matrix Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryId",
    "status",
    "sourceOfTruthIntent",
    "updatedAt",
    "reconciliationRules",
    "surfaces"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "registryId": {
      "const": "lingo-legacy-canonical-surface-matrix"
    },
    "status": {
      "enum": [
        "DRAFT_UNRECONCILED",
        "RECONCILED_PENDING_ACCEPTANCE",
        "ACCEPTED"
      ]
    },
    "sourceOfTruthIntent": {
      "type": "string",
      "minLength": 20
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\\\d{4}-\\\\d{2}-\\\\d{2}$"
    },
    "reconciliationRules": {
      "type": "object",
      "required": [
        "unknownValuesBlockRelease",
        "inventoryEntryIsNotDeploymentEvidence",
        "productionAuthorizationEnabled",
        "requireStableSurfaceId",
        "requireOwnerAndEnvironmentEvidence",
        "requireDependencyAndOsReconciliation"
      ],
      "properties": {
        "unknownValuesBlockRelease": {
          "const": true
        },
        "inventoryEntryIsNotDeploymentEvidence": {
          "const": true
        },
        "productionAuthorizationEnabled": {
          "const": false
        },
        "requireStableSurfaceId": {
          "const": true
        },
        "requireOwnerAndEnvironmentEvidence": {
          "const": true
        },
        "requireDependencyAndOsReconciliation": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surfaceId",
          "coverageGroup",
          "stack",
          "owner",
          "environment",
          "osTargets",
          "deploymentTarget",
          "dependencies",
          "status",
          "requiredGates",
          "evidenceRefs"
        ],
        "properties": {
          "surfaceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]+$"
          },
          "coverageGroup": {
            "type": "string",
            "minLength": 1
          },
          "stack": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "osTargets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "deploymentTarget": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "UNRECONCILED",
              "RECONCILED",
              "ACCEPTED"
            ]
          },
          "requiredGates": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "enum": [
                "G00",
                "G01",
                "G02",
                "G03",
                "G04",
                "G05",
                "G06",
                "G07",
                "G08",
                "G09",
                "G10",
                "G11"
              ]
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
