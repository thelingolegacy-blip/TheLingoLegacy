{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/lingo-dispatch-routes.v1.schema.json",
  "title": "LINGO Dispatch Routes",
  "type": "object",
  "required": [
    "schema_version",
    "authority",
    "mode",
    "dispatch_defaults",
    "severity_routes",
    "triggers",
    "approval_gates"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "authority": {
      "type": "string",
      "const": "LINGOlegacy_MASTER"
    },
    "mode": {
      "type": "string"
    },
    "dispatch_defaults": {
      "type": "object",
      "required": [
        "retry_max",
        "backoff_seconds",
        "dedupe_window_seconds",
        "include_secrets",
        "include_raw_pii"
      ],
      "properties": {
        "retry_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "backoff_seconds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "dedupe_window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "include_secrets": {
          "const": false
        },
        "include_raw_pii": {
          "const": false
        }
      }
    },
    "severity_routes": {
      "type": "object",
      "required": [
        "SEV0",
        "SEV1",
        "SEV2",
        "SEV3"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner",
          "acknowledgement",
          "auto_actions",
          "approval_required"
        ]
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "event",
          "severity",
          "route",
          "when",
          "action",
          "forbidden"
        ],
        "properties": {
          "event": {
            "type": "string",
            "minLength": 3
          },
          "severity": {
            "enum": [
              "SEV0",
              "SEV1",
              "SEV2",
              "SEV3"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "approval_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
