{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://thelingolegacy.com/schemas/auto-mode/e2e-suite-manifest.schema.json",
  "title":"Lingo Legacy E2E Suite Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","suite_id","name","environment","tests"],
  "properties":{
    "schema_version":{"type":"string","const":"1.0"},
    "suite_id":{"type":"string","pattern":"^[a-z0-9._-]+$"},
    "name":{"type":"string","minLength":1},
    "environment":{"enum":["dev","staging","prod"]},
    "tests":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","command"],"properties":{"id":{"type":"string"},"command":{"type":"string","minLength":1},"timeout_seconds":{"type":"integer","minimum":1,"maximum":3600}}}},
    "deployment_version":{"type":"string"},
    "artifact_prefix":{"type":"string"}
  }
}