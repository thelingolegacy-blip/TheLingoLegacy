{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/surface-matrix.schema.json",
  "title": "The Lingo Legacy Surface Matrix Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "surface_id",
    "name",
    "owner",
    "lifecycle",
    "criticality",
    "exposure",
    "identity_policy",
    "authorization_policy",
    "tenant_isolation",
    "data_classification",
    "api_contract",
    "deployment_profile",
    "slo_profile",
    "runbook",
    "status"
  ],
  "properties": {
    "surface_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 2
    },
    "lifecycle": {
      "enum": [
        "proposed",
        "development",
        "staging",
        "production",
        "deprecated",
        "retired"
      ]
    },
    "criticality": {
      "enum": [
        "tier-0",
        "tier-1",
        "tier-2",
        "tier-3"
      ]
    },
    "exposure": {
      "enum": [
        "public",
        "customer-authenticated",
        "partner-authenticated",
        "internal",
        "workload-only"
      ]
    },
    "identity_policy": {
      "type": "string",
      "minLength": 1
    },
    "authorization_policy": {
      "type": "string",
      "minLength": 1
    },
    "tenant_isolation": {
      "enum": [
        "not-applicable",
        "pooled-rls",
        "dedicated-data",
        "dedicated-environment"
      ]
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "api_contract": {
      "type": [
        "string",
        "null"
      ]
    },
    "deployment_profile": {
      "type": "string",
      "minLength": 1
    },
    "slo_profile": {
      "type": "string",
      "minLength": 1
    },
    "runbook": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "data_assets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "proposed",
        "implemented",
        "tested",
        "deployed",
        "verified",
        "blocked"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference"
        ],
        "properties": {
          "kind": {
            "enum": [
              "commit",
              "workflow",
              "test-report",
              "deployment",
              "review",
              "runbook"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "last_reviewed": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
