{
  "schemaVersion": "1.0",
  "deploymentProvider": "cloudflare",
  "sourceAuthority": "github",
  "requiredEnvironment": "production",
  "noVercelExecutionPath": true,
  "promotionSequence": [
    "source",
    "build",
    "tests",
    "security",
    "secrets",
    "vercel-eradication",
    "routes",
    "interactions",
    "apis",
    "identity",
    "games",
    "commerce",
    "assets",
    "audio",
    "motion",
    "accessibility",
    "performance",
    "cloudflare",
    "artifact",
    "promotion-boundary",
    "deploy",
    "live-probes",
    "evidence",
    "certificate"
  ],
  "failurePolicy": "FAIL_CLOSED",
  "evidenceRequiredForCertification": true,
  "certificateRequiresLiveDeployment": true,
  "certificateRequiresRollbackTarget": true
}
