{
  "schemaVersion": "1.0.0",
  "status": "PROPOSED",
  "defaultMode": "READ_ONLY",
  "globalDefaults": {
    "timeoutSeconds": 900,
    "maxRetries": 2,
    "maxConcurrentTasks": 4,
    "requireTaskId": true,
    "requireSourceProvenance": true,
    "requireAuditRecord": true,
    "onMissingEvidence": "BLOCK_OR_UNKNOWN",
    "onPolicyConflict": "STOP_AND_ESCALATE",
    "onTimeout": "EXPIRED_NOT_PASSED",
    "onUnauthorized": "BLOCKED",
    "selfApprovalAllowed": false
  },
  "taskOptions": [
    {"id":"inventory","mode":"read_only","description":"Enumerate repository/platform resources and gaps","approval":"not_required_for_repo_reads","outputs":["inventory.json","evidence-index.json"],"acceptance":["source and observation time present","unknowns explicit","no secrets included"]},
    {"id":"diagnose","mode":"read_only","description":"Correlate evidence and rank hypotheses without asserting unproven causes","approval":"not_required_for_repo_reads","outputs":["diagnosis.md","hypothesis-register.json"],"acceptance":["each hypothesis linked to evidence","contradictory evidence retained","root cause marked unconfirmed until reproduced"]},
    {"id":"plan","mode":"read_only","description":"Produce ordered tasks, dependencies, alternatives, risks, and rollback","approval":"not_required","outputs":["plan.md","dependency-graph.json"],"acceptance":["owner and exit criteria for each task","safe stop condition","no implicit mutation"]},
    {"id":"validate_static","mode":"local_no_network","description":"Schema, policy, lint, and deterministic unit validation","approval":"required before code is added","outputs":["test-report.json","toolchain-provenance.json"],"acceptance":["exact command and source SHA recorded","exit code and output retained","no production endpoints used"]},
    {"id":"validate_sandbox","mode":"isolated_nonproduction","description":"Run approved tests in ephemeral container/namespace","approval":"explicit task approval","outputs":["run-metadata.json","logs","test-report.json"],"acceptance":["isolated target verified","no production credentials","cleanup verified"]},
    {"id":"patch_proposal","mode":"isolated_branch","description":"Prepare reviewed diff on a dedicated branch","approval":"explicit task approval","outputs":["branch","diff","tests","rollback-notes"],"acceptance":["scope bounded","no default-branch push","review requested","tests accurately reported"]},
    {"id":"jira_plan","mode":"read_only","description":"Inspect Jira projects/issues and propose tasks","approval":"not_required_for_reads","outputs":["jira-inventory.json","proposed-issues.md"],"acceptance":["project and issue type confirmed","existing duplicate check performed","no write made"]},
    {"id":"jira_create_issue","mode":"limited_write","description":"Create one approved Jira issue","approval":"explicit per-task approval","outputs":["issue-key","issue-url","audit-record"],"acceptance":["project selected","issue type valid","duplicate search performed","idempotency and result recorded"]},
    {"id":"docker_review","mode":"read_only","description":"Review Dockerfiles, Compose, image provenance, SBOM, and container security","approval":"not_required_for_repo_reads","outputs":["container-review.md","risk-list.json"],"acceptance":["no Docker socket exposed","base image/pinning risks noted","no image published"]},
    {"id":"kubernetes_review","mode":"read_only","description":"Review manifests, RBAC, probes, resources, policies, and rollout strategy","approval":"not_required_for_repo_reads","outputs":["k8s-review.md","manifest-inventory.json"],"acceptance":["no cluster mutation","Secret values not read","production context remains denied"]},
    {"id":"memory_restore","mode":"read_only","description":"Restore project state from authoritative records and mark uncertainty","approval":"not_required","outputs":["restoration-report.md","source-map.json"],"acceptance":["sources ranked by authority","conflicts surfaced","no invented history","current invariants restated"]},
    {"id":"independent_acceptance","mode":"read_only_independent","description":"Review evidence generated by another agent/team","approval":"reviewer must be independent","outputs":["acceptance-record.json"],"acceptance":["all predicates met","evidence independently retrievable","reviewer is not author","failed/missing criteria remain blocked"]}
  ],
  "requiredTaskEnvelope": ["taskId","requestId","createdAtUtc","requestedBy","taskType","mode","target","sourceRef","sourceShaOrResourceId","allowedCapabilities","deniedCapabilities","deadlineUtc","retryBudget","expectedOutputs","acceptancePredicate","approvalRef","idempotencyKey"],
  "forbiddenImplicitActions": ["merge","deploy","rollback","activate","workflow_dispatch","runner_mutation","permissions_change","secret_rotation","DNS_change","Kubernetes_mutation","Jira_transition","payment_action"]
}
