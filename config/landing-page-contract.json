{
  "schemaVersion": "1.0",
  "site": {
    "name": "The Lingo Legacy",
    "canonicalOrigin": "https://thelingolegacy.com",
    "aliases": ["https://www.thelingolegacy.com"],
    "pageModel": "static-html-with-cloudflare-worker-edge-runtime",
    "rootDocument": "index.html",
    "notFoundDocument": "404.html",
    "sitemap": "sitemap.xml",
    "robots": "robots.txt",
    "manifest": "manifest.webmanifest"
  },
  "homepage": {
    "direction": "unified-flagship",
    "headlineText": "One Legacy.",
    "headlineAccentText": "Many Worlds.",
    "primaryDestination": "/thats-my-lingo/",
    "universeDestination": "/universe/",
    "brandTagline": "Loyalty. Legacy. Language."
  },
  "deployment": {
    "provider": "cloudflare-workers-static-assets",
    "workerEntrypoint": "worker.js",
    "config": "wrangler.jsonc",
    "workerName": "thelingolegacyv-5",
    "cloudflareGitBuildTargetWorkerName": "thelingolegacyv-5",
    "assetDirectory": ".",
    "assetBinding": "ASSETS",
    "canonicalHostRedirect": "www-to-apex",
    "productionChangesRequireAuthorization": true,
    "expectedRootRouteOwner": "thelingolegacyv-5",
    "expectedExactRootRoutePattern": "thelingolegacy.com/",
    "liveRouteInventoryMustMatch": true,
    "previewBuildTargetMustExist": true
  },
  "runtime": {
    "healthPath": "/healthz",
    "apiPrefix": "/api/",
    "requiredEndpoints": [
      "/api/v1/runtime",
      "/api/v1/platform/manifest",
      "/api/v1/platform/status",
      "/api/v1/platform/gates",
      "/api/v1/platform/modules",
      "/api/v1/site/context"
    ],
    "securityHeaderSource": "worker.js",
    "staticAssetExclusionFile": ".assetsignore"
  },
  "requiredPublicFiles": [
    "index.html",
    "404.html",
    "robots.txt",
    "sitemap.xml",
    "manifest.webmanifest"
  ],
  "requiredLandingMetadata": {
    "canonical": "https://thelingolegacy.com/",
    "minimumPrimaryRoutes": [
      "/thats-my-lingo/",
      "/universe/",
      "/loyalty-lane-apparel/",
      "/trust-compliance/",
      "/privacy/",
      "/terms/",
      "/contact/"
    ]
  },
  "governance": {
    "ciMustFailClosed": true,
    "buildSuccessIsNotReleaseAcceptance": true,
    "noCredentialFabrication": true,
    "noProductionPromotionWithoutIndependentEvidence": true,
    "requiredExternalAcceptance": [
      "Reconcile the live exact apex-root route with the configured Worker before any production route change",
      "Correct the Cloudflare Git build integration target to the existing intended Worker and verify a successful preview build",
      "Explicitly classify the active Vercel integration as preview-only or retire it through a separately authorized change",
      "Verify live apex, www, health, runtime, primary destinations, security headers, and deployed source provenance",
      "Restore G02 runner dispatch and collect independently retrievable CI evidence"
    ]
  }
}
