{
  "schemaVersion": "1.0",
  "site": {
    "name": "The Lingo Legacy",
    "canonicalOrigin": "https://thelingolegacy.com",
    "aliases": [
      "https://www.thelingolegacy.com"
    ],
    "pageModel": "static-html-with-cloudflare-worker-edge-runtime",
    "rootDocument": "index.html",
    "notFoundDocument": "404.html",
    "sitemap": "sitemap.xml",
    "robots": "robots.txt",
    "manifest": "manifest.webmanifest"
  },
  "homepage": {
    "direction": "hybrid-discovery-catalog",
    "headlineText": "One Legacy.",
    "headlineAccentText": "Many Worlds.",
    "primaryDestination": "/thats-my-lingo/",
    "universeDestination": "/universe/",
    "brandTagline": "Loyalty. Legacy. Language.",
    "discoveryFeatures": {
      "search": true,
      "categoryFilters": [
        "games",
        "hub",
        "commerce",
        "stories",
        "creative"
      ],
      "inPageProductInformation": true,
      "directDestinationLinks": true
    },
    "destinationStatus": {
      "allowedValues": [
        "verified",
        "unavailable",
        "unverified"
      ],
      "defaultValue": "unverified",
      "mustNotInferLiveAvailabilityFromSourcePresence": true
    }
  },
  "deployment": {
    "provider": "cloudflare-workers-static-assets",
    "workerEntrypoint": "worker.js",
    "config": "wrangler.jsonc",
    "workerName": "thelingolegacyv-5",
    "cloudflareGitBuildTargetWorkerName": "thelingolegacyv-5",
    "assetDirectory": ".",
    "assetBinding": "ASSETS",
    "canonicalHostRedirect": "www-to-apex",
    "productionChangesRequireAuthorization": true,
    "expectedRootRouteOwner": "lingo-flagship-root",
    "expectedExactRootRoutePattern": "thelingolegacy.com/",
    "liveRouteInventoryMustMatch": true,
    "previewBuildTargetMustExist": true,
    "expectedWildcardRouteOwner": "thelingolegacyv-5",
    "expectedWildcardRoutePattern": "thelingolegacy.com/*",
    "expectedWwwRoutePattern": "www.thelingolegacy.com/*",
    "rootWorkerSnapshotPath": "cloudflare/flagship-root/live-snapshot-2026-10-29.html",
    "previewWorkerPath": "cloudflare/flagship-root/preview-worker.js",
    "previewWorkerConfig": "wrangler.flagship-preview.toml",
    "previewWorkerName": "lingo-legacy-flagship-preview",
    "previewHasProductionRoutes": false,
    "rootSourceParityStatus": "snapshot-captured; canonical-index-preview-and-live-source-parity-pending"
  },
  "runtime": {
    "healthPath": "/healthz",
    "apiPrefix": "/api/",
    "requiredEndpoints": [
      "/api/v1/runtime",
      "/api/v1/platform/manifest",
      "/api/v1/platform/status",
      "/api/v1/platform/gates",
      "/api/v1/platform/modules",
      "/api/v1/site/context"
    ],
    "securityHeaderSource": "worker.js",
    "staticAssetExclusionFile": ".assetsignore"
  },
  "requiredPublicFiles": [
    "index.html",
    "404.html",
    "robots.txt",
    "sitemap.xml",
    "manifest.webmanifest"
  ],
  "requiredLandingMetadata": {
    "canonical": "https://thelingolegacy.com/",
    "minimumPrimaryRoutes": [
      "/thats-my-lingo/",
      "/universe/",
      "/loyalty-lane-apparel/",
      "/trust-compliance/",
      "/privacy/",
      "/terms/",
      "/contact/"
    ]
  },
  "governance": {
    "ciMustFailClosed": true,
    "buildSuccessIsNotReleaseAcceptance": true,
    "noCredentialFabrication": true,
    "noProductionPromotionWithoutIndependentEvidence": true,
    "requiredExternalAcceptance": [
      "Reconcile the live exact apex-root route with the configured Worker before any production route change",
      "Review an isolated preview-only Cloudflare build configuration for the intended Worker; preserve the existing fail-closed production build configuration, then verify a successful preview build with no production deployment capability",
      "Explicitly classify the active Vercel integration as preview-only or retire it through a separately authorized change",
      "Verify live apex, www, health, runtime, primary destinations, security headers, and deployed source provenance",
      "Restore G02 runner dispatch and collect independently retrievable CI evidence",
      "Verify each homepage destination in the isolated preview and only then change its route-status label to verified or unavailable; do not infer live availability from source files or a successful preview build."
    ]
  }
}
