{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/ops-resource-registry.schema.json",
  "title": "LINGO Operations Resource Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authority",
    "generatedAt",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRepository",
        "sourceBranch"
      ],
      "properties": {
        "sourceRepository": {
          "type": "string"
        },
        "sourceBranch": {
          "type": "string"
        },
        "productionMutationPolicy": {
          "type": "string",
          "enum": [
            "frozen",
            "approval_required",
            "authorized"
          ]
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "purpose",
        "provider",
        "environment",
        "criticality",
        "lifecycleState",
        "integrationState",
        "lastVerifiedAt",
        "evidence",
        "owner"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "source_repository",
            "source_branch",
            "ci_pipeline",
            "runner",
            "edge",
            "dns",
            "domain",
            "hosting",
            "identity",
            "database",
            "storage",
            "api",
            "application",
            "control_center",
            "release_system",
            "observability",
            "security",
            "backup",
            "integration",
            "tool",
            "license",
            "budget",
            "documentation"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "authoritativeReference": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "enum": [
            "portfolio",
            "local",
            "development",
            "test",
            "staging",
            "production",
            "disaster_recovery",
            "unknown"
          ]
        },
        "criticality": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "owner": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lifecycleState": {
          "type": "string",
          "enum": [
            "active",
            "planned",
            "blocked",
            "maintenance",
            "retired",
            "unknown"
          ]
        },
        "integrationState": {
          "type": "string",
          "enum": [
            "verified",
            "configured_unverified",
            "scaffold_only",
            "blocked",
            "stale",
            "unknown",
            "retired"
          ]
        },
        "lastVerifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secretReferences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "provider",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "present_unverified",
                  "verified",
                  "missing",
                  "rotation_required",
                  "unknown"
                ]
              }
            }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primaryRoute": {
              "type": "string"
            },
            "secondaryRoute": {
              "type": "string"
            },
            "restoreRunbook": {
              "type": "string"
            },
            "rollbackReference": {
              "type": "string"
            },
            "backupReference": {
              "type": "string"
            }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "billingModel": {
              "type": "string"
            },
            "quota": {
              "type": "string"
            },
            "spendLimit": {
              "type": "string"
            },
            "verifiedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
