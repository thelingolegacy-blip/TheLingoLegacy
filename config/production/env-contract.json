{
  "schemaVersion": "2.0",
  "description": "Non-secret environment and runtime contract for The Lingo Legacy production hard-lock. This repository is Cloudflare-first; secret values never belong in source control.",
  "environments": ["development", "preview", "production"],
  "requiredProduction": [
    { "key": "SITE_URL", "category": "site", "purpose": "Canonical production site URL." },
    { "key": "PUBLIC_SITE_URL", "category": "site", "purpose": "Explicit public production URL." },
    { "key": "NEXT_PUBLIC_FIREBASE_API_KEY", "category": "firebase", "purpose": "Public Firebase app configuration." },
    { "key": "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN", "category": "firebase", "purpose": "Firebase Auth domain." },
    { "key": "NEXT_PUBLIC_FIREBASE_PROJECT_ID", "category": "firebase", "purpose": "Firebase project identifier." },
    { "key": "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET", "category": "firebase", "purpose": "Firebase Storage bucket identifier." },
    { "key": "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID", "category": "firebase", "purpose": "Firebase messaging sender ID." },
    { "key": "NEXT_PUBLIC_FIREBASE_APP_ID", "category": "firebase", "purpose": "Firebase app ID." }
  ],
  "forbiddenInRepo": [
    "Cloudflare API tokens",
    "Firebase service-account JSON",
    "private keys",
    "API tokens",
    "passwords",
    "raw webhook secrets",
    "payment provider secret keys"
  ],
  "dashboardVerificationRequired": [
    "Cloudflare Worker bindings and secrets",
    "Cloudflare D1/KV/R2 resources where enabled",
    "Firebase Auth, Firestore rules, Storage rules, backups, environment separation",
    "Payment provider live-mode configuration, products, prices, webhooks, receipts, tax, refunds, and fraud controls when commerce is activated",
    "DNS and custom-domain configuration",
    "Analytics retention and access policy"
  ]
}
