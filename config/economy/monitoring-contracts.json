{
  "version": "2026-07-30",
  "mode": "static-contract",
  "collections": {
    "economy_metrics": {
      "description": "Current aggregate economy state for dashboard reads.",
      "example": {
        "bonesIssued": 1200000,
        "bonesSpent": 900000,
        "netInflation": 300000,
        "xpVelocity": 850000,
        "rewardPressure": 0.72,
        "fraudRisk": 14,
        "spendingImbalance": 38,
        "stressIndex": 41,
        "status": "watch",
        "updatedAt": "serverTimestamp"
      }
    },
    "economy_reports": {
      "description": "Daily snapshots for trend analysis and AI review.",
      "example": {
        "date": "2026-07-30",
        "metrics": {
          "bonesIssued": 1200000,
          "bonesSpent": 900000,
          "netInflation": 300000,
          "xpVelocity": 850000,
          "rewardPressure": 0.72,
          "fraudRisk": 14,
          "spendingImbalance": 38,
          "stressIndex": 41
        },
        "recommendations": [
          "Reduce daily login bonus by 5%",
          "Add a mid-tier Bones sink",
          "Increase quest difficulty slightly"
        ],
        "createdAt": "serverTimestamp"
      }
    },
    "economy_alerts": {
      "description": "AI or rule generated economy warnings.",
      "example": {
        "type": "inflation_spike",
        "severity": "high",
        "message": "Bones issued increased 32% in 24 hours.",
        "metric": "bonesIssued",
        "currentValue": 1200000,
        "threshold": 900000,
        "status": "open",
        "createdAt": "serverTimestamp",
        "resolvedAt": null
      }
    },
    "economy_recommendations": {
      "description": "Admin-reviewable balancing actions.",
      "example": {
        "action": "reduce_daily_bonus",
        "value": 5,
        "unit": "percent",
        "reason": "Inflation is trending upward while spending is flat.",
        "confidence": 0.78,
        "approvalState": "pending",
        "createdAt": "serverTimestamp",
        "approvedBy": null,
        "appliedAt": null
      }
    },
    "economy_history": {
      "description": "Append-only trend points for long-term forecasting.",
      "example": {
        "timestamp": "serverTimestamp",
        "bonesIssued": 1200000,
        "bonesSpent": 900000,
        "netInflation": 300000,
        "xpVelocity": 850000,
        "rewardPressure": 0.72,
        "fraudRisk": 14,
        "stressIndex": 41
      }
    },
    "economy_auto_actions": {
      "description": "Append-only Auto-Mode decision and execution audit log.",
      "example": {
        "actionId": "auto_20260730_currency_001",
        "domain": "currency",
        "signal": "normalizedInflationScore > 60",
        "selectedAction": "reduce_daily_bonus",
        "executionMode": "recommendation_only",
        "stressIndexBefore": 64,
        "stressIndexAfter": null,
        "metricSnapshot": {
          "bonesIssued": 1400000,
          "bonesSpent": 720000,
          "netInflation": 680000
        },
        "safetyCapApplied": "5_percent_per_cycle",
        "rollbackPlan": "Restore previous daily bonus value from policy snapshot.",
        "approvalState": "pending",
        "createdAt": "serverTimestamp",
        "approvedBy": null,
        "executedAt": null
      }
    }
  },
  "stressIndexFormula": {
    "inflationScore": 0.25,
    "xpVelocityScore": 0.2,
    "rewardPressureScore": 0.2,
    "fraudRiskScore": 0.2,
    "spendingImbalanceScore": 0.15
  },
  "thresholds": {
    "inflationWatch": 300000,
    "inflationCritical": 500000,
    "issuanceSpikePercent24h": 30,
    "spendingCollapsePercent24h": 25,
    "fraudWatch": 50,
    "fraudCritical": 75
  },
  "remediationPolicy": {
    "defaultMode": "recommendation_only",
    "requiresAdminApproval": true,
    "blockedActions": [
      "automatic_wallet_freeze",
      "automatic_balance_mutation",
      "automatic_store_price_change",
      "automatic_reward_payout_reduction"
    ]
  },
  "autoMode": {
    "defaultState": "recommendation_only",
    "loopMinutes": 5,
    "globalModes": [
      "off",
      "recommendation_only",
      "approval_required",
      "active_with_caps"
    ],
    "domains": {
      "currency": {
        "enabled": false,
        "maxDailyAdjustmentPercent": 5
      },
      "xp": {
        "enabled": false,
        "maxDailyAdjustmentPercent": 5
      },
      "rewards": {
        "enabled": false,
        "maxDailyAdjustmentPercent": 10
      },
      "fraud": {
        "enabled": false,
        "destructiveActionsRequireApproval": true
      },
      "behavior": {
        "enabled": false,
        "forecastOnly": true
      }
    },
    "playbook": [
      {
        "domain": "currency",
        "signal": "normalizedInflationScore > 60",
        "action": "reduce_daily_bonus",
        "cap": "5_percent_per_cycle",
        "executionMode": "recommendation_only"
      },
      {
        "domain": "currency",
        "signal": "bonesHoardingRatio > 0.40",
        "action": "activate_bones_sink_proposal",
        "cap": "one_sink_per_cycle",
        "executionMode": "recommendation_only"
      },
      {
        "domain": "currency",
        "signal": "bonesSpentDropPercent24h > 25",
        "action": "lower_selected_store_prices",
        "cap": "10_percent_per_day",
        "executionMode": "approval_required"
      },
      {
        "domain": "xp",
        "signal": "xpVelocitySpikePercent24h > 30",
        "action": "reduce_xp_multiplier",
        "cap": "5_percent_per_cycle",
        "executionMode": "recommendation_only"
      },
      {
        "domain": "xp",
        "signal": "normalizedXpInflationScore > 50",
        "action": "add_xp_sink_proposal",
        "cap": "one_sink_per_cycle",
        "executionMode": "recommendation_only"
      },
      {
        "domain": "xp",
        "signal": "xpBurstDetected == true",
        "action": "increase_high_yield_cooldowns",
        "cap": "10_percent_per_day",
        "executionMode": "approval_required"
      },
      {
        "domain": "rewards",
        "signal": "rewardPressure > 0.70",
        "action": "raise_reward_costs",
        "cap": "10_percent_per_day",
        "executionMode": "approval_required"
      },
      {
        "domain": "rewards",
        "signal": "rewardPressure < 0.30",
        "action": "lower_reward_costs",
        "cap": "5_percent_per_day",
        "executionMode": "approval_required"
      },
      {
        "domain": "fraud",
        "signal": "fraudRisk > 40",
        "action": "throttle_payout_recommendation",
        "cap": "policy_defined",
        "executionMode": "approval_required"
      },
      {
        "domain": "fraud",
        "signal": "fraudRisk > 60",
        "action": "freeze_wallet_recommendation",
        "cap": "case_by_case",
        "executionMode": "approval_required"
      }
    ],
    "auditRequiredFields": [
      "actionId",
      "domain",
      "signal",
      "selectedAction",
      "executionMode",
      "stressIndexBefore",
      "metricSnapshot",
      "safetyCapApplied",
      "rollbackPlan",
      "createdAt"
    ]
  }
}
