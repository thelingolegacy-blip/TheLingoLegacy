    "worldShifts": { "enabled": true, "cron": "0 9 * * MON", "fallbackWorldId": "neon_world" }
  },
  "safety": {
    "content": {
      "slangWhitelistRequired": true,
      "humanReviewRequired": true,
      "blockedCategories": ["slurs", "hate", "sexual_content", "harassment", "self_harm"],
      "fallbackPackId": "approved_starter_pack"
    },
    "system": {
      "rateLimitKeys": ["userId", "sessionId", "ip"],
      "circuitBreaker": { "aiProviderFailures": 3, "windowMinutes": 5, "fallback": "cached_or_curated_content" },
      "auditEconomyMutations": true
    },
    "player": {
      "disclosure": "AI flavor never controls wins, losses, volatility, or rewards.",
      "noCashValueRequired": true,
      "noEmotionalManipulation": true
    }
  },
  "aiFlavor": {
    "allowedUses": ["slang_generation", "mascot_dialog", "event_names", "seasonal_lore", "cosmetic_descriptions"],
    "forbiddenUses": ["spin_outcomes", "payouts", "jackpot_selection", "volatility_changes", "reward_grants"],
    "cacheKey": "sha256(prompt + parameters + safetyVersion)",
    "ttlSeconds": 86400,
    "reviewState": "draft_until_approved"
  }
