{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.client.json",
      "**/.*",
      "**/node_modules/**",
      "**/firebase-functions/**",
      "**/*.rules",
      "**/tsconfig.json",
      "**/catalog-seed.json",
      "**/.env*",
      "**/service-account*.json",
      "**/firebase-adminsdk*.json",
      "**/credentials*.json",
      "**/secrets*.json",
      "**/*.pem",
      "**/*.key",
      "**/*.tfstate*",
      "**/*.tfvars*",
      "**/.git/**",
      "**/.github/**",
      "**/ops/**",
      "**/scripts/**",
      "**/tests/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
