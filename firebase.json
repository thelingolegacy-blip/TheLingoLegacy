{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.client.json",
      "**/.*",
      "**/node_modules/**",
      "**/.github/**",
      "**/lib/**",
      "**/test/**",
      "**/android/**",
      "**/ios/**",
      "**/macos/**",
      "**/windows/**",
      "**/linux/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "database": {
    "rules": "firebase/database.rules.json"
  }
}
