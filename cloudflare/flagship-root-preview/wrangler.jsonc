{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingo-flagship-site-preview",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "persist": true }
  }
}
