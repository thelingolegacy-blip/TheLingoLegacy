{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thelingolegacy.com/schemas/lingo-studio-enterprise-module-registry.schema.json",
  "title": "LINGO Studio Enterprise Module Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "sourceAuthority",
    "registryAuthority",
    "runtimeAuthority",
    "observedAt",
    "mode",
    "productionMutation",
    "statusVocabulary",
    "modules",
    "providerReadiness",
    "globalControls"
  ],
  "properties": {
    "schema": {
      "const": "lingo-studio-enterprise-module-registry"
    },
    "version": {
      "type": "string"
    },
    "sourceAuthority": {
      "type": "string"
    },
    "registryAuthority": {
      "type": "string"
    },
    "runtimeAuthority": {
      "type": "string"
    },
    "observedAt": {
      "type": "string",
      "format": "date"
    },
    "mode": {
      "const": "read-only-until-separately-authorized"
    },
    "productionMutation": {
      "const": false
    },
    "statusVocabulary": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "LIVE_VERIFIED",
          "HISTORICAL_EVIDENCE",
          "SOURCE_DECLARED",
          "PREVIEW_ONLY",
          "BLOCKED",
          "PLANNED",
          "UNKNOWN"
        ]
      },
      "uniqueItems": true
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "scope",
          "status",
          "permissions",
          "writeAuthority",
          "requiredEvidence",
          "route"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "LIVE_VERIFIED",
              "HISTORICAL_EVIDENCE",
              "SOURCE_DECLARED",
              "PREVIEW_ONLY",
              "BLOCKED",
              "PLANNED",
              "UNKNOWN"
            ]
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "writeAuthority": {
            "const": false
          },
          "requiredEvidence": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "observedAt",
              "confidence",
              "correlationId"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "observedAt": {
                "type": "string",
                "format": "date-time"
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "correlationId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "providerReadiness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "status",
          "evidence",
          "writeAuthority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "LIVE_VERIFIED",
              "HISTORICAL_EVIDENCE",
              "SOURCE_DECLARED",
              "PREVIEW_ONLY",
              "BLOCKED",
              "PLANNED",
              "UNKNOWN"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "writeAuthority": {
            "const": false
          }
        }
      },
      "minItems": 1
    },
    "globalControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultMode",
        "productionMutation",
        "secretValues",
        "clientProviderCredentials",
        "autonomousMerge",
        "autonomousDeploy",
        "autonomousBilling",
        "autonomousWalletOrRewardMutation",
        "autonomousAccessGrant",
        "unknownState"
      ],
      "properties": {
        "defaultMode": {
          "const": "read-only"
        },
        "productionMutation": {
          "const": "DENY"
        },
        "secretValues": {
          "const": "NEVER_DISPLAY"
        },
        "clientProviderCredentials": {
          "const": "PROHIBITED"
        },
        "autonomousMerge": {
          "const": "DENY"
        },
        "autonomousDeploy": {
          "const": "DENY"
        },
        "autonomousBilling": {
          "const": "DENY"
        },
        "autonomousWalletOrRewardMutation": {
          "const": "DENY"
        },
        "autonomousAccessGrant": {
          "const": "DENY"
        },
        "unknownState": {
          "const": "FAIL_CLOSED"
        }
      }
    }
  }
}
