{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://thelingolegacy.com/schemas/dmc-handoff.schema.json",
  "title":"LINGOlegacy DMC Agent Handoff",
  "type":"object","additionalProperties":false,
  "required":["handoffId","tenantId","projectId","realmId","taskId","requesterUid","senderAgentId","receiverAgentId","humanOwnerUid","purpose","scope","allowedTools","prohibitedActions","inputRefs","expectedOutput","acceptanceCriteria","risk","status","createdAt","expiresAt","attempt","version"],
  "properties":{
    "handoffId":{"type":"string","minLength":1},
    "tenantId":{"type":"string","minLength":1},
    "projectId":{"type":"string","minLength":1},
    "realmId":{"type":"string","minLength":1},
    "taskId":{"type":"string","minLength":1},
    "requesterUid":{"type":"string","minLength":1},
    "senderAgentId":{"type":"string","minLength":1},
    "receiverAgentId":{"type":"string","minLength":1},
    "humanOwnerUid":{"type":"string","minLength":1},
    "purpose":{"type":"string","minLength":1,"maxLength":2000},
    "scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "allowedTools":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "prohibitedActions":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "inputRefs":{"type":"array","items":{"type":"string"}},
    "expectedOutput":{"type":"string","minLength":1},
    "acceptanceCriteria":{"type":"array","minItems":1,"items":{"type":"string"}},
    "risk":{"enum":["R0","R1","R2","R3","R4"]},
    "status":{"enum":["CREATED","ACCEPTED","IN_PROGRESS","READY_FOR_REVIEW","COMPLETED","REJECTED","BLOCKED","EXPIRED","CANCELLED"]},
    "createdAt":{"type":"string","format":"date-time"},
    "expiresAt":{"type":"string","format":"date-time"},
    "attempt":{"type":"integer","minimum":0,"maximum":5},
    "version":{"type":"integer","minimum":1},
    "parentHandoffId":{"type":["string","null"]},
    "lastIdempotencyKey":{"type":["string","null"]},
    "lastCommandFingerprint":{"type":["string","null"]},
    "acceptedByUid":{"type":["string","null"]},
    "completedByUid":{"type":["string","null"]}
  }
}