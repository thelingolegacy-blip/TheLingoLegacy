{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://thelingolegacy.com/schemas/dmc-audit-event.schema.json",
  "title":"LINGOlegacy DMC Append-only Audit Event",
  "type":"object","additionalProperties":false,
  "required":["event_id","schema_version","occurred_at","correlation_id","tenant_id","subject_uid","subject_type","agent_id","event_type","action","resource_id","project_id","realm_id","environment","policy_version","decision","reason_code","payload_digest","source_commit"],
  "properties":{
    "event_id":{"type":"string","minLength":1},
    "schema_version":{"const":"1.0.0"},
    "occurred_at":{"type":"string","format":"date-time"},
    "correlation_id":{"type":"string","minLength":1},
    "tenant_id":{"type":"string","minLength":1},
    "subject_uid":{"type":"string","minLength":1},
    "subject_type":{"enum":["human","agent","service"]},
    "agent_id":{"type":["string","null"]},
    "event_type":{"enum":["POLICY_DECISION","APPROVAL_REQUESTED","APPROVAL_DECIDED","APPROVAL_CONSUMED","HANDOFF_TRANSITION","CONTROL_FAILURE"]},
    "action":{"type":"string"},
    "resource_id":{"type":"string"},
    "project_id":{"type":"string"},
    "realm_id":{"type":"string"},
    "environment":{"enum":["demo","development","staging","production"]},
    "policy_version":{"type":"string"},
    "decision":{"enum":["ALLOW","DENY","APPROVE","REJECT","TRANSITION","FAIL"]},
    "reason_code":{"type":"string"},
    "approval_id":{"type":["string","null"]},
    "approver_uid":{"type":["string","null"]},
    "before_digest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "after_digest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "payload_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_commit":{"type":"string","minLength":7},
    "workflow_run_id":{"type":["string","null"]},
    "artifact_digest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "summary":{"type":"string","maxLength":500}
  }
}