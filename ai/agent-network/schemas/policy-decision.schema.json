{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://thelingolegacy.com/schemas/dmc-policy-decision.schema.json",
  "title":"LINGOlegacy DMC Policy Decision",
  "type":"object","additionalProperties":false,
  "required":["decision_id","allowed","reason_code","policy_version","evaluated_at","subject_uid","agent_id","action","resource_id","tenant_id","project_id","realm_id","environment","risk","approval_id","audit_required"],
  "properties":{
    "decision_id":{"type":"string","minLength":1},
    "allowed":{"type":"boolean"},
    "reason_code":{"enum":["ALLOW_SCOPED_READ","ALLOW_DRAFT","ALLOW_APPROVED_ACTION","APPROVAL_REQUIRED","IDENTITY_INVALID","SCOPE_MISMATCH","ROLE_FORBIDDEN","SELF_APPROVAL","APPROVAL_MISSING","APPROVAL_INVALID","APPROVAL_EXPIRED","APPROVAL_REPLAY","POLICY_VERSION_MISMATCH","PRODUCTION_HOLD","AUDIT_UNAVAILABLE","RISK_POLICY_DENY","RESOURCE_MISMATCH","ENVIRONMENT_MISMATCH"]},
    "policy_version":{"type":"string"},
    "evaluated_at":{"type":"string","format":"date-time"},
    "subject_uid":{"type":"string"},
    "agent_id":{"type":["string","null"]},
    "action":{"type":"string"},
    "resource_id":{"type":"string"},
    "tenant_id":{"type":"string"},
    "project_id":{"type":"string"},
    "realm_id":{"type":"string"},
    "environment":{"enum":["demo","development","staging","production"]},
    "risk":{"enum":["R0","R1","R2","R3","R4"]},
    "approval_id":{"type":["string","null"]},
    "audit_required":{"const":true}
  }
}