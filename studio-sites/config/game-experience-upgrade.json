{
  "schemaVersion": "1.0.0",
  "status": "development-specification-not-release-accepted",
  "principle": "Shared technology rails; isolated game identity, content, assets, audio, profiles, and telemetry per world.",
  "sharedRuntime": {
    "animation": {
      "timeline": "deterministic-event-driven",
      "supports": [
        "reel-spin",
        "symbol-land",
        "win-highlight",
        "cascade",
        "character-emote",
        "scene-transition",
        "particle-burst"
      ],
      "reducedMotion": "replace-continuous-motion-with-short-state-transitions"
    },
    "audio": {
      "defaultState": "muted-until-user-gesture",
      "controls": [
        "master",
        "music",
        "effects",
        "voice"
      ],
      "supports": [
        "ui-cues",
        "reel-loop",
        "reel-stop",
        "card-deal",
        "card-flip",
        "win-stinger",
        "bonus-stinger",
        "ambient-loop"
      ],
      "licenseGate": "verified-original-or-explicitly-licensed"
    },
    "visuals": {
      "formats": [
        "SVG",
        "WebP",
        "AVIF",
        "PNG"
      ],
      "responsiveVariants": true,
      "contrastAndAltTextRequired": true
    },
    "profiles": {
      "localPreviewOnly": true,
      "fields": [
        "displayName",
        "avatarId",
        "avatarFrameId",
        "bannerId",
        "earnedBadges",
        "cosmeticLoadout"
      ],
      "privateByDefault": true,
      "identityIntegration": "not-connected"
    },
    "assetIsolation": {
      "namespaceRequired": true,
      "immutableVersionedPaths": true,
      "sha256RequiredForRelease": true,
      "rightsReviewRequired": true,
      "noCrossWorldAssetReuseWithoutExplicitGrant": true
    },
    "economy": {
      "demoOnly": true,
      "realMoneyWagering": false,
      "cashout": false,
      "redeemableValue": false,
      "sweepstakesEnabled": false
    }
  },
  "gameClasses": {
    "deluxeSlots": {
      "sharedFeatures": [
        "5-reel-engine",
        "configurable-3-or-5-row-layout",
        "payline-evaluation",
        "wild-symbols",
        "expanding-wilds",
        "free-spins",
        "bonus-rounds",
        "symbol-cascades",
        "win-celebrations",
        "missions-and-xp",
        "cosmetic-profiles"
      ],
      "math": "game-specific-reviewed-paytable-required",
      "rng": "local-demo-only-not-certified"
    },
    "deluxeCards": {
      "sharedFeatures": [
        "touch-first-card-controls",
        "turn-state-machine",
        "legal-move-validation",
        "table-and-seat-animations",
        "card-deal-and-flip-audio",
        "player-profiles",
        "bot-difficulty-options",
        "match-history-preview"
      ],
      "competitiveResults": "server-authoritative-service-required"
    },
    "arcadeAdventure": {
      "sharedFeatures": [
        "character-roster",
        "movement-and-emotes",
        "world-scenes",
        "quests-and-challenges",
        "collectibles",
        "camera-transitions",
        "controller-and-touch-input",
        "save-state-contract"
      ],
      "physics": "deterministic-simulation-and-replay-tests-required"
    }
  },
