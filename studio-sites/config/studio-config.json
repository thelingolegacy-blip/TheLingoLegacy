{
  "schemaVersion": "1.0.0",
  "studioWorldRegistry": "config/studio-world-registry.json",
  "worldIsolation": "Each entity owns its visual, asset, audio, navigation, and telemetry namespaces; shared platform services remain centrally governed.",
  "product": {
    "name": "The Lingo Legacy",
    "tagline": "Loyalty. Legacy. Language.",
    "theme": "industrial-noir",
    "accentColors": [
      "gold",
      "royal-purple"
    ],
    "canonicalNaming": "LINGO + lowercase product/service"
  },
  "environments": {
    "development": {
      "enabled": true,
      "externalWrites": false
    },
    "preview": {
      "enabled": true,
      "externalWrites": false
    },
    "production": {
      "enabled": false,
      "activationAuthorized": false
    }
  },
  "routes": {
    "hub": "/studio-sites/",
    "arcade": "/studio-sites/lingoarcade/",
    "slots": "/studio-sites/lingoslots/",
    "playerDashboard": "/studio-sites/dashboard/",
    "doughboysOasis": "/studio-sites/games/doughboys-oasis-vertical-slice.html",
    "oasisStore": "/studio-sites/games/doughboys-oasis-store.html",
    "oasis856Region": "/studio-sites/games/doughboys-oasis-856-region.html",
    "doughboysOasisModePlatformHub": "/studio-sites/games/doughboys-oasis-mode-platform-hub.html",
    "doughboysOasisLifeLegacyLab": "/studio-sites/games/doughboys-oasis-life-legacy-lab.html"
  },
  "services": {
    "identity": {
      "mode": "stub",
      "requiredForProduction": true
    },
    "wallet": {
      "mode": "local-demo-only",
      "realValue": false,
      "redeemable": false
    },
    "leaderboards": {
      "mode": "demo-data",
      "serverAuthoritative": false
    },
    "referrals": {
      "mode": "local-demo-only",
      "rewardsEnabled": false
    },
    "notifications": {
      "mode": "local-demo-only"
    },
    "sweepstakes": {
      "enabled": false,
      "reason": "Requires approved rules, eligibility, jurisdiction, no-purchase method where applicable, privacy and legal review."
    },
    "store": {
      "mode": "local-demo-only",
      "authoritativeBackend": false,
      "realPayments": false,
      "realMoneyWagering": false,
      "cashout": false
    },
    "maps": {
      "mode": "fictional-static-demo",
      "gpsEnabled": false,
      "providerConfigured": false
    },
    "api": {
      "mode": "design-only-not-provisioned",
      "edgeWorkerConfigured": false
    }
  },
  "gates": {
    "runnerG02": "BLOCKED_UNTIL_AUTHENTIC_HOST_EVIDENCE",
    "build": "REQUIRED",
    "functionalQA": "REQUIRED",
    "securityReview": "REQUIRED",
    "accessibilityReview": "REQUIRED",
    "assetRights": "REQUIRED",
    "independentPublicReachability": "REQUIRED",
    "mergeAuthorization": "REQUIRED",
    "productionActivation": "DISABLED"
  },
  "policy": {
    "failClosed": true,
    "productionMutationFreeze": true,
    "lastKnownGoodProtected": true,
    "realMoneyWagering": false,
    "cashout": false,
    "productionDeploy": false
  },
  "observability": {
    "eventsRequireCorrelationId": true,
    "redactSecrets": true,
    "clientTelemetryIsNotReleaseEvidence": true
  },
  "integrations": {
    "git": {
      "canonicalHost": "GitHub",
      "gitLabMirror": "not-configured",
      "productionAuthority": "single-protected-release-pipeline"
    }
  }
}
