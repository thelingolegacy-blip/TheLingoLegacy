{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thelingolegacy-staging",
  "main": "worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "routes": [],
  "vars": {
    "CANONICAL_DOMAIN": "thelingolegacy-staging.thelingolegacy.workers.dev",
    "PUBLIC_SITE_URL": "https://thelingolegacy-staging.thelingolegacy.workers.dev",
    "LINGO_ENVIRONMENT": "staging"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./staging-assets",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
